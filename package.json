{
  "name": "omosuen",
  "version": "0.1.0",
  "description": "Omosuen - An axonometric game engine with fixed z-axis camera. Etymology: Omos (Greek: shoulder/axis) + Suen (Mesopotamian moon deity/measurement)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "npm run build:dev && npm run build:prod",
    "build:dev": "webpack --config webpack.config.js --env mode=development",
    "build:prod": "webpack --config webpack.config.js --env mode=production",
    "test": "npx serve test -p 3000",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "game-engine",
    "axonometric",
    "isometric",
    "2d",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "serve": "^14.2.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.6.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.0"
  }
}
