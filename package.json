{
  "name": "omosuen",
  "version": "0.1.14",
  "description": "Omosuen - An axonometric game engine with fixed z-axis camera. Etymology: Omos (Greek: shoulder/axis) + Suen (Mesopotamian moon deity/measurement)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "npm run build:dev && npm run build:prod",
    "build:dev": "webpack --config webpack.config.js --env mode=development",
    "build:prod": "webpack --config webpack.config.js --env mode=production",
    "test": "start http://localhost:3000/ && node test/integration-test-server.js",
    "test:cli": "tsx test/cli.test.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.js\" \"*.json\""
  },
  "keywords": [
    "game-engine",
    "axonometric",
    "isometric",
    "2d",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "raw-loader": "^4.0.2",
    "serve": "^14.2.0",
    "ts-loader": "^9.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.0"
  }
}
