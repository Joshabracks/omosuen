{
  "name": "omosuen-aseprite-loader",
  "version": "0.2.0",
  "description": "Official Omosuen plugin: the `aseprite-loader` component ingests Aseprite (.aseprite/.ase) files into layered, animated entities. Dependency-free, browser-static.",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./src": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsc -p tsconfig.json && npx webpack --config webpack.config.cjs",
    "build:esm": "npx tsc -p tsconfig.json",
    "build:browser": "npx webpack --config webpack.config.cjs"
  },
  "keywords": [
    "omosuen",
    "omosuen-plugin",
    "aseprite",
    "pixel-art",
    "sprite",
    "animation"
  ],
  "license": "ISC",
  "peerDependencies": {
    "omosuen": "*"
  },
  "peerDependenciesMeta": {
    "omosuen": {
      "optional": true
    }
  }
}
